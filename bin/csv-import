#!/bin/bash

set -euo pipefail

echo "$DB_FILE"

sqlite3 "$DB_FILE" <<'SQL'
ATTACH 'seed/seed.db' AS seed;

BEGIN;

INSERT OR REPLACE INTO events (id, name, planning_center_id, auto_fetch)
SELECT id, name, planning_center_id, 1
FROM seed.events;

INSERT OR REPLACE INTO location_groups (id, name)
SELECT id, name
FROM seed.location_groups;

INSERT OR REPLACE INTO locations (id, planning_center_id, planning_center_parent_id, location_group_id, event_id, name, auto_fetch, last_checked_out_time)
SELECT id, planning_center_id, planning_center_parent_id, location_group_id, event_id, name, auto_fetch, last_checked_out_time
FROM seed.locations;

COMMIT;
DETACH seed;

SQL
