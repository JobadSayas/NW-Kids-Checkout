#!/bin/bash

set -euo pipefail

echo "$DB_FILE"

sqlite3 "$DB_FILE" <<'SQL'
ATTACH 'seed/seed.db' AS seed;

BEGIN;

INSERT INTO events
SELECT *
FROM seed.events;

INSERT INTO location_groups
SELECT *
FROM seed.location_groups;

INSERT INTO locations
SELECT *
FROM seed.locations;

COMMIT;
DETACH seed;

SQL
