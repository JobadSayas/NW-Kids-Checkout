PRAGMA foreign_keys=off;
BEGIN TRANSACTION;

CREATE TABLE manual_checkins_new
(
    id                       INTEGER PRIMARY KEY,
    first_name               TEXT NOT NULL,
    last_name                TEXT NOT NULL,
    checked_out_at           DATETIME,
    checked_out_confirmed_at DATETIME DEFAULT NULL
);

INSERT INTO manual_checkins_new (id, first_name, last_name, checked_out_at, checked_out_confirmed_at)
SELECT id, first_name, last_name, checked_out_at, checked_out_confirmed_at
FROM manual_checkins;

DROP TABLE manual_checkins;
ALTER TABLE manual_checkins_new RENAME TO manual_checkins;

CREATE INDEX idx_manual_checked_out_at ON manual_checkins (checked_out_at);

COMMIT;
PRAGMA foreign_keys=on;
